{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cyberx-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "vars": {
    "ADMIN_PASSWORD": "admin",
    "MAX_SESSION_DURATION_MS": "1800000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cyberx-db",
      "database_id": "local-db",
      "migrations_dir": "../database/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "cyberx-r2"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AUDIO_ROOM",
        "class_name": "AudioRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AudioRoom"]
    }
  ]
}