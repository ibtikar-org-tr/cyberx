{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cyberx-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "vars": {
    "ADMIN_PASSWORD": "admin",
    "MAX_SESSION_DURATION_MS": "1800000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cyberx-db",
      "database_id": "local-db"
    }
  ]
}